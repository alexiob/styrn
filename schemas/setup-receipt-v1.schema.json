{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://styrn.dev/schemas/setup-receipt-v1.schema.json",
  "title": "Styrn setup receipt v1",
  "description": "Append-only ownership journal for finalized setup actions. Normative source: docs/design.md Part 15.6.1.",
  "type": "object",
  "required": ["schema_version", "installation_scope", "entries"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": 1 },
    "installation_scope": { "enum": ["user", "system"] },
    "entries": {
      "type": "array",
      "description": "Entry IDs are additionally checked across the complete array, and resource ownership conflicts are checked within each entry by the runtime semantic validator.",
      "items": { "$ref": "#/$defs/entry" }
    },
    "pending_publications": {
      "type": "array",
      "description": "Append-only witnessed-current pending epochs. The runtime additionally requires unique publication IDs and timestamps, no publication ID collision with a receipt entry, unique action and entry IDs within each epoch, monotonic receipt entry counts, immutable publication prefixes, links to the latest earlier pending entry with the same action ID, a new pending receipt entry before an action can reappear after omission, and no duplicate legacy pending occurrence outside that epoch history.",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/pendingPublication" }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "installation_scope": { "const": "user" } },
        "required": ["installation_scope"]
      },
      "then": {
        "properties": {
          "entries": {
            "items": {
              "properties": { "privilege_used": { "const": "none" } },
              "required": ["privilege_used"]
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "entries": {
            "contains": {
              "properties": {
                "action": {
                  "properties": {
                    "type": { "const": "dedicated_account_prerequisite" }
                  },
                  "required": ["type"]
                }
              },
              "required": ["action"]
            }
          }
        },
        "required": ["entries"]
      },
      "then": {
        "properties": { "installation_scope": { "const": "user" } },
        "required": ["installation_scope"]
      }
    },
    {
      "if": {
        "properties": {
          "entries": {
            "contains": {
              "properties": {
                "action": {
                  "properties": { "type": { "const": "current_user_ssh" } },
                  "required": ["type"]
                }
              },
              "required": ["action"]
            }
          }
        },
        "required": ["entries"]
      },
      "then": {
        "properties": { "installation_scope": { "const": "user" } },
        "required": ["installation_scope"]
      }
    },
    {
      "if": {
        "properties": {
          "entries": {
            "contains": {
              "properties": {
                "action": {
                  "properties": { "type": { "const": "deferred_system_action" } },
                  "required": ["type"]
                }
              },
              "required": ["action"]
            }
          }
        },
        "required": ["entries"]
      },
      "then": {
        "properties": { "installation_scope": { "const": "user" } },
        "required": ["installation_scope"]
      }
    },
    {
      "if": {
        "properties": {
          "entries": {
            "contains": {
              "properties": {
                "action": {
                  "properties": { "type": { "const": "scope_promotion" } },
                  "required": ["type"]
                }
              },
              "required": ["action"]
            }
          }
        },
        "required": ["entries"]
      },
      "then": {
        "properties": { "installation_scope": { "const": "user" } },
        "required": ["installation_scope"]
      }
    }
  ],
  "$defs": {
    "pendingPublication": {
      "type": "object",
      "required": ["publication_id", "timestamp", "receipt_entry_count", "pending"],
      "additionalProperties": false,
      "properties": {
        "publication_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "timestamp": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?Z$"
        },
        "receipt_entry_count": { "type": "integer", "minimum": 0 },
        "pending": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/pendingPublicationLink" }
        }
      }
    },
    "pendingPublicationLink": {
      "type": "object",
      "required": ["action_id", "entry_id"],
      "additionalProperties": false,
      "properties": {
        "action_id": {
          "type": "string",
          "pattern": "^[a-z](?:[a-z0-9-]*[a-z0-9])?(?:\\.[a-z](?:[a-z0-9-]*[a-z0-9])?)+$"
        },
        "entry_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        }
      }
    },
    "entry": {
      "type": "object",
      "required": [
        "entry_id",
        "action",
        "timestamp",
        "privilege_used",
        "files_created",
        "files_modified",
        "services",
        "accounts",
        "registry_keys",
        "firewall_rules",
        "download_provenance",
        "status"
      ],
      "additionalProperties": false,
      "properties": {
        "entry_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "action": { "$ref": "#/$defs/action" },
        "timestamp": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?Z$"
        },
        "privilege_used": { "enum": ["none", "root", "admin"] },
        "directories_created": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/createdDirectory" }
        },
        "files_created": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/createdFile" }
        },
        "files_modified": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/modifiedFile" }
        },
        "services": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/namedResource" }
        },
        "accounts": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/namedResource" }
        },
        "registry_keys": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/registryKey" }
        },
        "firewall_rules": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/namedResource" }
        },
        "download_provenance": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/downloadProvenance" }
          ]
        },
        "status": { "enum": ["applied", "pending", "adopted"] }
      },
      "allOf": [
        {
          "if": {
            "properties": { "status": { "const": "pending" } },
            "required": ["status"]
          },
          "then": {
            "properties": {
              "privilege_used": { "const": "none" },
              "directories_created": { "maxItems": 0 },
              "files_created": { "maxItems": 0 },
              "files_modified": { "maxItems": 0 },
              "services": { "maxItems": 0 },
              "accounts": { "maxItems": 0 },
              "registry_keys": { "maxItems": 0 },
              "firewall_rules": { "maxItems": 0 },
              "download_provenance": { "type": "null" }
            }
          }
        },
        {
          "if": {
            "properties": {
              "action": {
                "properties": { "type": { "const": "worker_directory" } },
                "required": ["type"]
              }
            },
            "required": ["action"]
          },
          "then": {
            "properties": {
              "files_created": { "maxItems": 0 },
              "files_modified": { "maxItems": 0 },
              "services": { "maxItems": 0 },
              "accounts": { "maxItems": 0 },
              "registry_keys": { "maxItems": 0 },
              "firewall_rules": { "maxItems": 0 },
              "download_provenance": { "type": "null" }
            },
            "allOf": [
              {
                "if": {
                  "properties": { "status": { "const": "pending" } },
                  "required": ["status"]
                },
                "else": {
                  "required": ["directories_created"],
                  "properties": {
                    "status": { "const": "applied" },
                    "directories_created": { "minItems": 1, "maxItems": 1 }
                  }
                }
              },
              {
                "if": {
                  "properties": {
                    "action": {
                      "properties": {
                        "parameters": {
                          "properties": { "installation_scope": { "const": "user" } },
                          "required": ["installation_scope"]
                        }
                      },
                      "required": ["parameters"]
                    }
                  },
                  "required": ["action"]
                },
                "then": {
                  "properties": { "privilege_used": { "const": "none" } }
                },
                "else": {
                  "properties": {
                    "status": { "const": "applied" },
                    "privilege_used": { "enum": ["root", "admin"] }
                  }
                }
              }
            ]
          }
        },
        {
          "if": {
            "properties": {
              "action": {
                "properties": {
                  "type": { "const": "dedicated_account_prerequisite" }
                },
                "required": ["type"]
              }
            },
            "required": ["action"]
          },
          "then": {
            "properties": {
              "status": { "const": "pending" },
              "privilege_used": { "const": "none" },
              "directories_created": { "maxItems": 0 },
              "files_created": { "maxItems": 0 },
              "files_modified": { "maxItems": 0 },
              "services": { "maxItems": 0 },
              "accounts": { "maxItems": 0 },
              "registry_keys": { "maxItems": 0 },
              "firewall_rules": { "maxItems": 0 },
              "download_provenance": { "type": "null" }
            }
          }
        },
        {
          "if": {
            "properties": {
              "action": {
                "properties": { "type": { "const": "current_user_ssh" } },
                "required": ["type"]
              }
            },
            "required": ["action"]
          },
          "then": {
            "properties": {
              "privilege_used": { "const": "none" },
              "services": { "maxItems": 0 },
              "accounts": { "maxItems": 0 },
              "registry_keys": { "maxItems": 0 },
              "firewall_rules": { "maxItems": 0 },
              "download_provenance": { "type": "null" }
            },
            "allOf": [
              {
                "if": {
                  "properties": { "status": { "const": "pending" } },
                  "required": ["status"]
                },
                "else": {
                  "properties": { "status": { "const": "applied" } },
                  "allOf": [
                    {
                      "if": {
                        "properties": {
                          "action": {
                            "properties": {
                              "parameters": {
                                "properties": { "action_id": { "const": "ssh.directory" } },
                                "required": ["action_id"]
                              }
                            },
                            "required": ["parameters"]
                          }
                        },
                        "required": ["action"]
                      },
                      "then": {
                        "properties": {
                          "directories_created": { "minItems": 1, "maxItems": 1 },
                          "files_created": { "maxItems": 0 },
                          "files_modified": { "maxItems": 0 }
                        }
                      },
                      "else": {
                        "properties": {
                          "directories_created": { "maxItems": 0 },
                          "files_created": { "minItems": 1, "maxItems": 1 },
                          "files_modified": { "maxItems": 0 }
                        }
                      }
                    }
                  ]
                }
              }
            ]
          }
        },
        {
          "if": {
            "properties": {
              "action": {
                "properties": { "type": { "const": "deferred_system_action" } },
                "required": ["type"]
              }
            },
            "required": ["action"]
          },
          "then": {
            "properties": {
              "status": { "const": "pending" },
              "privilege_used": { "const": "none" },
              "directories_created": { "maxItems": 0 },
              "files_created": { "maxItems": 0 },
              "files_modified": { "maxItems": 0 },
              "services": { "maxItems": 0 },
              "accounts": { "maxItems": 0 },
              "registry_keys": { "maxItems": 0 },
              "firewall_rules": { "maxItems": 0 },
              "download_provenance": { "type": "null" }
            }
          }
        },
        {
          "if": {
            "properties": {
              "action": {
                "properties": { "type": { "const": "scope_promotion" } },
                "required": ["type"]
              }
            },
            "required": ["action"]
          },
          "then": {
            "properties": {
              "status": { "const": "applied" },
              "privilege_used": { "const": "none" },
              "directories_created": { "maxItems": 0 },
              "files_created": { "maxItems": 0 },
              "files_modified": { "maxItems": 0 },
              "services": { "maxItems": 0 },
              "accounts": { "maxItems": 0 },
              "registry_keys": { "maxItems": 0 },
              "firewall_rules": { "maxItems": 0 },
              "download_provenance": { "type": "null" }
            }
          }
        }
      ]
    },
    "action": {
      "oneOf": [
        { "$ref": "#/$defs/foundationAction" },
        { "$ref": "#/$defs/currentUserSshAction" },
        { "$ref": "#/$defs/dedicatedAccountPrerequisiteAction" },
        { "$ref": "#/$defs/deferredSystemAction" },
        { "$ref": "#/$defs/scopePromotionAction" },
        { "$ref": "#/$defs/workerDirectoryAction" }
      ]
    },
    "foundationAction": {
      "type": "object",
      "required": ["type", "parameters"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "foundation" },
        "parameters": {
          "type": "object",
          "required": ["action_id"],
          "additionalProperties": false,
          "properties": {
            "action_id": {
              "allOf": [
                { "$ref": "#/$defs/actionIdentifier" },
                { "not": { "enum": ["ssh.directory", "ssh.authorized-keys"] } }
              ]
            }
          }
        }
      }
    },
    "currentUserSshAction": {
      "type": "object",
      "required": ["type", "parameters"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "current_user_ssh" },
        "parameters": {
          "type": "object",
          "required": ["action_id", "principal", "directory", "path"],
          "additionalProperties": false,
          "properties": {
            "action_id": { "enum": ["ssh.directory", "ssh.authorized-keys"] },
            "principal": {
              "allOf": [
                { "$ref": "#/$defs/workerPrincipal" },
                {
                  "properties": { "account_policy": { "const": "current-user" } },
                  "required": ["account_policy"]
                }
              ]
            },
            "directory": { "$ref": "#/$defs/absolutePath" },
            "path": { "$ref": "#/$defs/absolutePath" }
          }
        }
      }
    },
    "dedicatedAccountPrerequisiteAction": {
      "type": "object",
      "required": ["type", "parameters"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "dedicated_account_prerequisite" },
        "parameters": {
          "type": "object",
          "required": ["action_id", "target_scope", "selector"],
          "additionalProperties": false,
          "properties": {
            "action_id": {
              "type": "string",
              "pattern": "^identity\\.account\\.dedicated\\.sha256-[0-9a-f]{64}$"
            },
            "target_scope": { "const": "system" },
            "selector": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256,
              "pattern": "^[A-Za-z0-9_](?:[A-Za-z0-9_.-]{0,254}[A-Za-z0-9_-])?$"
            }
          }
        }
      }
    },
    "workerDirectoryAction": {
      "type": "object",
      "required": ["type", "parameters"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "worker_directory" },
        "parameters": {
          "type": "object",
          "required": [
            "action_id",
            "installation_scope",
            "principal",
            "root",
            "node",
            "path"
          ],
          "additionalProperties": false,
          "properties": {
            "action_id": { "$ref": "#/$defs/actionIdentifier" },
            "installation_scope": { "enum": ["user", "system"] },
            "principal": { "$ref": "#/$defs/workerPrincipal" },
            "root": { "$ref": "#/$defs/absolutePath" },
            "node": { "$ref": "#/$defs/workerDirectoryNode" },
            "path": { "$ref": "#/$defs/absolutePath" }
          },
          "allOf": [
            {
              "if": {
                "properties": { "installation_scope": { "const": "user" } },
                "required": ["installation_scope"]
              },
              "then": {
                "properties": {
                  "principal": {
                    "properties": { "account_policy": { "const": "current-user" } },
                    "required": ["account_policy"]
                  }
                }
              },
              "else": {
                "properties": {
                  "principal": {
                    "properties": { "account_policy": { "const": "dedicated" } },
                    "required": ["account_policy"]
                  }
                }
              }
            }
          ]
        }
      }
    },
    "deferredSystemAction": {
      "type": "object",
      "required": ["type", "parameters"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "deferred_system_action" },
        "parameters": {
          "type": "object",
          "required": ["action_id", "target_scope", "target_principal", "parameter_sha256"],
          "additionalProperties": false,
          "properties": {
            "action_id": { "$ref": "#/$defs/actionIdentifier" },
            "target_scope": { "const": "system" },
            "target_principal": {
              "allOf": [
                { "$ref": "#/$defs/workerPrincipal" },
                {
                  "properties": { "account_policy": { "const": "dedicated" } },
                  "required": ["account_policy"]
                }
              ]
            },
            "parameter_sha256": { "$ref": "#/$defs/sha256" }
          }
        }
      }
    },
    "scopePromotionAction": {
      "type": "object",
      "required": ["type", "parameters"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "scope_promotion" },
        "parameters": {
          "type": "object",
          "required": [
            "action_id",
            "machine_id",
            "source_scope",
            "target_scope",
            "user_manifest_path",
            "user_manifest_sha256",
            "system_manifest_path",
            "system_manifest_sha256",
            "original_operator",
            "target_principal",
            "selector_sha256",
            "promotion_intent_id"
          ],
          "additionalProperties": false,
          "properties": {
            "action_id": { "const": "identity.scope-promotion" },
            "machine_id": {
              "type": "string",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
            },
            "source_scope": { "const": "user" },
            "target_scope": { "const": "system" },
            "user_manifest_path": { "$ref": "#/$defs/absolutePath" },
            "user_manifest_sha256": { "$ref": "#/$defs/sha256" },
            "system_manifest_path": { "$ref": "#/$defs/absolutePath" },
            "system_manifest_sha256": { "$ref": "#/$defs/sha256" },
            "system_manifest_identity_sha256": { "$ref": "#/$defs/sha256" },
            "system_receipt_path": { "$ref": "#/$defs/absolutePath" },
            "system_receipt_sha256": { "$ref": "#/$defs/sha256" },
            "system_receipt_identity_sha256": { "$ref": "#/$defs/sha256" },
            "authorization_request_id": {
              "type": "string",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
            },
            "authorization_request_sha256": { "$ref": "#/$defs/sha256" },
            "authorization_record_path": { "$ref": "#/$defs/absolutePath" },
            "authorization_record_sha256": { "$ref": "#/$defs/sha256" },
            "authorization_record_identity_sha256": { "$ref": "#/$defs/sha256" },
            "promotion_intent_path": { "$ref": "#/$defs/absolutePath" },
            "promotion_intent_sha256": { "$ref": "#/$defs/sha256" },
            "promotion_intent_identity_sha256": { "$ref": "#/$defs/sha256" },
            "completion_record_path": { "$ref": "#/$defs/absolutePath" },
            "completion_record_sha256": { "$ref": "#/$defs/sha256" },
            "completion_record_identity_sha256": { "$ref": "#/$defs/sha256" },
            "original_operator": {
              "allOf": [
                { "$ref": "#/$defs/workerPrincipal" },
                {
                  "properties": { "account_policy": { "const": "current-user" } },
                  "required": ["account_policy"]
                }
              ]
            },
            "target_principal": {
              "allOf": [
                { "$ref": "#/$defs/workerPrincipal" },
                {
                  "properties": { "account_policy": { "const": "dedicated" } },
                  "required": ["account_policy"]
                }
              ]
            },
            "selector_sha256": { "$ref": "#/$defs/sha256" },
            "promotion_intent_id": {
              "type": "string",
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
            }
          },
          "oneOf": [
            {
              "required": [
                "system_manifest_identity_sha256",
                "system_receipt_path",
                "system_receipt_sha256",
                "system_receipt_identity_sha256",
                "authorization_request_id",
                "authorization_request_sha256",
                "authorization_record_path",
                "authorization_record_sha256",
                "authorization_record_identity_sha256",
                "promotion_intent_path",
                "promotion_intent_sha256",
                "promotion_intent_identity_sha256",
                "completion_record_path",
                "completion_record_sha256",
                "completion_record_identity_sha256"
              ]
            },
            {
              "not": {
                "anyOf": [
                  { "required": ["system_manifest_identity_sha256"] },
                  { "required": ["system_receipt_path"] },
                  { "required": ["system_receipt_sha256"] },
                  { "required": ["system_receipt_identity_sha256"] },
                  { "required": ["authorization_request_id"] },
                  { "required": ["authorization_request_sha256"] },
                  { "required": ["authorization_record_path"] },
                  { "required": ["authorization_record_sha256"] },
                  { "required": ["authorization_record_identity_sha256"] },
                  { "required": ["promotion_intent_path"] },
                  { "required": ["promotion_intent_sha256"] },
                  { "required": ["promotion_intent_identity_sha256"] },
                  { "required": ["completion_record_path"] },
                  { "required": ["completion_record_sha256"] },
                  { "required": ["completion_record_identity_sha256"] }
                ]
              }
            }
          ]
        }
      }
    },
    "actionIdentifier": {
      "type": "string",
      "pattern": "^[a-z](?:[a-z0-9-]*[a-z0-9])?(?:\\.[a-z](?:[a-z0-9-]*[a-z0-9])?)+$"
    },
    "workerPrincipal": {
      "type": "object",
      "required": ["account_policy", "principal_kind", "principal_id", "name"],
      "additionalProperties": false,
      "properties": {
        "account_policy": { "enum": ["current-user", "dedicated"] },
        "principal_kind": { "enum": ["unix-uid", "windows-sid"] },
        "principal_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "principal_kind": { "const": "unix-uid" } },
            "required": ["principal_kind"]
          },
          "then": {
            "properties": { "principal_id": { "pattern": "^[1-9][0-9]*$" } }
          },
          "else": {
            "properties": {
              "principal_id": {
                "pattern": "^S-1-[0-9]+(?:-[0-9]+){1,15}$"
              }
            }
          }
        }
      ]
    },
    "workerDirectoryNode": {
      "oneOf": [
        {
          "type": "object",
          "required": ["type", "ordinal"],
          "additionalProperties": false,
          "properties": {
            "type": { "const": "support" },
            "ordinal": { "type": "integer", "minimum": 0, "maximum": 65535 }
          }
        },
        { "$ref": "#/$defs/workerDirectoryRootNode" },
        { "$ref": "#/$defs/workerDirectoryReposNode" },
        { "$ref": "#/$defs/workerDirectoryJobsNode" },
        { "$ref": "#/$defs/workerDirectoryCacheNode" },
        { "$ref": "#/$defs/workerDirectoryArtifactsNode" },
        { "$ref": "#/$defs/workerDirectoryLogsNode" }
      ]
    },
    "workerDirectoryRootNode": {
      "$ref": "#/$defs/workerDirectoryRootNodeShape"
    },
    "workerDirectoryRootNodeShape": {
      "type": "object",
      "required": ["type"],
      "additionalProperties": false,
      "properties": { "type": { "const": "root" } }
    },
    "workerDirectoryReposNode": {
      "type": "object",
      "required": ["type"],
      "additionalProperties": false,
      "properties": { "type": { "const": "repos" } }
    },
    "workerDirectoryJobsNode": {
      "type": "object",
      "required": ["type"],
      "additionalProperties": false,
      "properties": { "type": { "const": "jobs" } }
    },
    "workerDirectoryCacheNode": {
      "type": "object",
      "required": ["type"],
      "additionalProperties": false,
      "properties": { "type": { "const": "cache" } }
    },
    "workerDirectoryArtifactsNode": {
      "type": "object",
      "required": ["type"],
      "additionalProperties": false,
      "properties": { "type": { "const": "artifacts" } }
    },
    "workerDirectoryLogsNode": {
      "type": "object",
      "required": ["type"],
      "additionalProperties": false,
      "properties": { "type": { "const": "logs" } }
    },
    "absolutePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "oneOf": [
        { "pattern": "^/(?:[^./][^/]*|\\.[^./][^/]*|\\.\\.[^/]+)(?:/(?:[^./][^/]*|\\.[^./][^/]*|\\.\\.[^/]+))*$|^/$" },
        { "pattern": "^[A-Za-z]:\\\\(?:[^.\\\\/:][^\\\\/:]*|\\.[^.\\\\/:][^\\\\/:]*|\\.\\.[^\\\\/:]+)(?:\\\\(?:[^.\\\\/:][^\\\\/:]*|\\.[^.\\\\/:][^\\\\/:]*|\\.\\.[^\\\\/:]+))*$" }
      ],
      "description": "Normalized absolute Unix or drive-qualified Windows path; runtime validation additionally rejects traversal, ADS, device namespaces, and reserved device names."
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "resourceName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "createdFile": {
      "type": "object",
      "required": ["path", "sha256"],
      "additionalProperties": false,
      "properties": {
        "path": { "$ref": "#/$defs/absolutePath" },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "createdDirectory": {
      "type": "object",
      "required": ["path"],
      "additionalProperties": false,
      "properties": {
        "path": { "$ref": "#/$defs/absolutePath" }
      }
    },
    "modifiedFile": {
      "type": "object",
      "required": ["path", "before_sha256", "backup_path"],
      "additionalProperties": false,
      "properties": {
        "path": { "$ref": "#/$defs/absolutePath" },
        "before_sha256": { "$ref": "#/$defs/sha256" },
        "backup_path": { "$ref": "#/$defs/absolutePath" }
      }
    },
    "namedResource": {
      "type": "object",
      "required": ["name"],
      "additionalProperties": false,
      "properties": {
        "name": { "$ref": "#/$defs/resourceName" }
      }
    },
    "registryKey": {
      "type": "object",
      "required": ["path"],
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string",
          "minLength": 6,
          "maxLength": 512,
          "pattern": "^(?:HKLM|HKEY_LOCAL_MACHINE)\\\\"
        }
      }
    },
    "downloadProvenance": {
      "type": "object",
      "required": ["url", "version", "sha256"],
      "additionalProperties": false,
      "properties": {
        "url": {
          "type": "string",
          "pattern": "^https://(?:\\[[0-9A-Fa-f:.]+\\]|[A-Za-z0-9](?:[A-Za-z0-9.-]*[A-Za-z0-9])?)(?::[0-9]{1,5})?(?:[/?][^#\\\\]*)?$"
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]*$"
        },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    }
  }
}
