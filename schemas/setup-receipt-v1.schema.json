{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://styrn.dev/schemas/setup-receipt-v1.schema.json",
  "title": "Styrn setup receipt v1",
  "description": "Append-only ownership journal for finalized setup actions. Normative source: docs/design.md Part 15.6.1.",
  "type": "object",
  "required": ["schema_version", "installation_scope", "entries"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": 1 },
    "installation_scope": { "enum": ["user", "system"] },
    "entries": {
      "type": "array",
      "description": "Entry IDs are additionally checked across the complete array, and resource ownership conflicts are checked within each entry by the runtime semantic validator.",
      "items": { "$ref": "#/$defs/entry" }
    },
    "pending_publications": {
      "type": "array",
      "description": "Append-only witnessed-current pending epochs. The runtime additionally requires unique publication IDs and timestamps, no publication ID collision with a receipt entry, unique action and entry IDs within each epoch, monotonic receipt entry counts, immutable publication prefixes, and links to the latest earlier pending entry with the same action ID.",
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/pendingPublication" }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "installation_scope": { "const": "user" } },
        "required": ["installation_scope"]
      },
      "then": {
        "properties": {
          "entries": {
            "items": {
              "properties": { "privilege_used": { "const": "none" } },
              "required": ["privilege_used"]
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "pendingPublication": {
      "type": "object",
      "required": ["publication_id", "timestamp", "receipt_entry_count", "pending"],
      "additionalProperties": false,
      "properties": {
        "publication_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "timestamp": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?Z$"
        },
        "receipt_entry_count": { "type": "integer", "minimum": 0 },
        "pending": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/pendingPublicationLink" }
        }
      }
    },
    "pendingPublicationLink": {
      "type": "object",
      "required": ["action_id", "entry_id"],
      "additionalProperties": false,
      "properties": {
        "action_id": {
          "type": "string",
          "pattern": "^[a-z](?:[a-z0-9-]*[a-z0-9])?(?:\\.[a-z](?:[a-z0-9-]*[a-z0-9])?)+$"
        },
        "entry_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        }
      }
    },
    "entry": {
      "type": "object",
      "required": [
        "entry_id",
        "action",
        "timestamp",
        "privilege_used",
        "files_created",
        "files_modified",
        "services",
        "accounts",
        "registry_keys",
        "firewall_rules",
        "download_provenance",
        "status"
      ],
      "additionalProperties": false,
      "properties": {
        "entry_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
        },
        "action": { "$ref": "#/$defs/action" },
        "timestamp": {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?Z$"
        },
        "privilege_used": { "enum": ["none", "root", "admin"] },
        "files_created": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/createdFile" }
        },
        "files_modified": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/modifiedFile" }
        },
        "services": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/namedResource" }
        },
        "accounts": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/namedResource" }
        },
        "registry_keys": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/registryKey" }
        },
        "firewall_rules": {
          "type": "array",
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/namedResource" }
        },
        "download_provenance": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/downloadProvenance" }
          ]
        },
        "status": { "enum": ["applied", "pending", "adopted"] }
      },
      "allOf": [
        {
          "if": {
            "properties": { "status": { "const": "pending" } },
            "required": ["status"]
          },
          "then": {
            "properties": {
              "privilege_used": { "const": "none" },
              "files_created": { "maxItems": 0 },
              "files_modified": { "maxItems": 0 },
              "services": { "maxItems": 0 },
              "accounts": { "maxItems": 0 },
              "registry_keys": { "maxItems": 0 },
              "firewall_rules": { "maxItems": 0 },
              "download_provenance": { "type": "null" }
            }
          }
        }
      ]
    },
    "action": {
      "type": "object",
      "required": ["type", "parameters"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "foundation" },
        "parameters": {
          "type": "object",
          "required": ["action_id"],
          "additionalProperties": false,
          "properties": {
            "action_id": {
              "type": "string",
              "pattern": "^[a-z](?:[a-z0-9-]*[a-z0-9])?(?:\\.[a-z](?:[a-z0-9-]*[a-z0-9])?)+$"
            }
          }
        }
      }
    },
    "absolutePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096,
      "oneOf": [
        { "pattern": "^/(?:[^./][^/]*|\\.[^./][^/]*|\\.\\.[^/]+)(?:/(?:[^./][^/]*|\\.[^./][^/]*|\\.\\.[^/]+))*$|^/$" },
        { "pattern": "^[A-Za-z]:\\\\(?:[^.\\\\/:][^\\\\/:]*|\\.[^.\\\\/:][^\\\\/:]*|\\.\\.[^\\\\/:]+)(?:\\\\(?:[^.\\\\/:][^\\\\/:]*|\\.[^.\\\\/:][^\\\\/:]*|\\.\\.[^\\\\/:]+))*$" }
      ],
      "description": "Normalized absolute Unix or drive-qualified Windows path; runtime validation additionally rejects traversal, ADS, device namespaces, and reserved device names."
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "resourceName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "createdFile": {
      "type": "object",
      "required": ["path", "sha256"],
      "additionalProperties": false,
      "properties": {
        "path": { "$ref": "#/$defs/absolutePath" },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "modifiedFile": {
      "type": "object",
      "required": ["path", "before_sha256", "backup_path"],
      "additionalProperties": false,
      "properties": {
        "path": { "$ref": "#/$defs/absolutePath" },
        "before_sha256": { "$ref": "#/$defs/sha256" },
        "backup_path": { "$ref": "#/$defs/absolutePath" }
      }
    },
    "namedResource": {
      "type": "object",
      "required": ["name"],
      "additionalProperties": false,
      "properties": {
        "name": { "$ref": "#/$defs/resourceName" }
      }
    },
    "registryKey": {
      "type": "object",
      "required": ["path"],
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string",
          "minLength": 6,
          "maxLength": 512,
          "pattern": "^(?:HKLM|HKEY_LOCAL_MACHINE)\\\\"
        }
      }
    },
    "downloadProvenance": {
      "type": "object",
      "required": ["url", "version", "sha256"],
      "additionalProperties": false,
      "properties": {
        "url": {
          "type": "string",
          "pattern": "^https://(?:\\[[0-9A-Fa-f:.]+\\]|[A-Za-z0-9](?:[A-Za-z0-9.-]*[A-Za-z0-9])?)(?::[0-9]{1,5})?(?:[/?][^#\\\\]*)?$"
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]*$"
        },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    }
  }
}
